# Hugo build output
/public/
/resources/

# Theme (separate repo, symlinked)
/themes/

# Hugo build lock
/.hugo_build.lock

# Like server runtime
/likes.json
/likes.json.bak

# Watch log
/watch.log

# OS / editor cruft
.DS_Store
*.swp
*.tmp
*~
.idea/
.vscode/

# Sponsor QRs (WeChat / Alipay) — private payment data, never push to GitHub.
# These live in static/images/sponsor/ locally for dev/build, but must NOT be
# tracked. deploy.sh copies them from local static/ → public/ on the server
# side, so production has them without ever touching the public repo.
static/images/sponsor/*.png
!static/images/sponsor/.gitkeep
